# Copy to .env and fill in locally. Never commit the real .env file.

# --- Database ---
MQ_DATABASE_URL=postgresql+psycopg://mq:mq@localhost:5433/monsoonquant

# --- Object storage (raw files, model artifacts) ---
MQ_OBJECT_STORE_BACKEND=local          # local | s3 | r2
MQ_OBJECT_STORE_PATH=./data/objects    # used when backend=local

# --- MLflow ---
MQ_MLFLOW_TRACKING_URI=http://localhost:5001

# --- External data sources (fill in if/when required) ---
MQ_CDS_API_KEY=
MQ_CDS_API_URL=https://cds.climate.copernicus.eu/api

# --- API ---
MQ_API_RATE_LIMIT_PER_MIN=60
MQ_API_KEY_SALT=

# --- Observability ---
MQ_SENTRY_DSN=

# --- Alerts (P2, not wired yet) ---
MQ_TELEGRAM_BOT_TOKEN=
MQ_ALERT_EMAIL_SMTP_URL=

# --- Ledger export (public git repo mirror) ---
MQ_LEDGER_PUBLIC_REPO_URL=
